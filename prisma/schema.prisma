generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id          Int     @id @default(autoincrement())
  title       String
  description String
  embedding   Unsupported("vector(1536)")
}

model Candidate {
  id        Int     @id @default(autoincrement())
  name      String
  summary   String
  embedding Unsupported("vector(1536)")
}